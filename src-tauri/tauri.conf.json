{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TicketPilot",
  "version": "0.1.0",
  "identifier": "co.tickets-ne.ticketpilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TicketPilot",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "center": true
      },
      {
        "label": "widget",
        "title": "TicketPilot · Cronómetro",
        "width": 340,
        "height": 176,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "x": 40,
        "y": 40
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Cronómetro y control de tickets de ClickUp",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
